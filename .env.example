AUTODOCS_ENVIRONMENT=development
AUTODOCS_GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
AUTODOCS_DOCS_REPO_URL=https://github.com/your-org/your-developer-docs.git
AUTODOCS_DOCS_REPO_BRANCH=main
AUTODOCS_QUEUE_BACKEND=inline
AUTODOCS_REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
OPENROUTER_REASONING_EFFORT=medium
